# Полная GET-ссылка организаторов (кнопка «Открыть GET для DEV» в гайде); group_id подменяется автоматически
CQA_SOURCE_URL=
# Модель оценки: Qwen3 30B через любой OpenAI-совместимый API (/chat/completions).
# Свой сервер (vLLM, Ollama, LM Studio) или провайдер. Для Ollama используйте qwen3:30b-cqa (окно 16k, см. README).
CQA_MODEL_BASE_URL=http://localhost:11434/v1
CQA_MODEL=qwen3:30b
# Ключ API сервера модели - нужен только провайдеру; своей Ollama / vLLM - нет. Можно ввести в Настройках
CQA_MODEL_API_KEY=
# Режим ответа: schema (строгая JSON Schema) или object (для серверов без поддержки схем)
CQA_JSON_MODE=schema
# Независимых прогонов на диалог (голосование) и сколько диалогов оценивать параллельно
CQA_VOTES=3
CQA_CONCURRENCY=4
# Сколько ждать ответа модели, секунд
CQA_MODEL_TIMEOUT=900
# Цена провайдера, USD за 1 млн токенов: для расчёта стоимости оценки (ТЗ). 0 - не считать
CQA_PRICE_INPUT_PER_MTOK=0
CQA_PRICE_OUTPUT_PER_MTOK=0
# Название команды для results.json
CQA_TEAM_NAME=
# Разрешённые origin для встраивания фронтенда с другого адреса (Dynamics 365), через запятую
CQA_CORS_ORIGINS=
# Вебхуки: события CQA (оценка готова, апелляция подана/решена, чек-лист изменён) уходят POST JSON
# на эти адреса через запятую, например в поток Power Automate «When an HTTP request is received»
CQA_WEBHOOK_URLS=
# Секрет для подписи тела вебхука: заголовок X-CQA-Signature: sha256=<HMAC-SHA256>. Пусто - без подписи
CQA_WEBHOOK_SECRET=
# Публичный адрес CQA для ссылок на карточку в событиях (например, https://cqa.company.kz)
CQA_PUBLIC_URL=
