# Ключ Claude API (console.anthropic.com → API Keys)
CQA_ANTHROPIC_API_KEY=
# Полная GET-ссылка организаторов (кнопка «Открыть GET для DEV» в гайде); group_id подменяется автоматически
CQA_SOURCE_URL=
# Модель и параметры по умолчанию
CQA_MODEL=claude-opus-5-5
CQA_EFFORT=high
CQA_VOTES=3
# Локальная модель (Ollama / LM Studio / любой OpenAI-совместимый endpoint)
CQA_OPENAI_BASE_URL=http://localhost:11434/v1
CQA_LOCAL_MODEL=qwen3-cqa
# Разрешённые origin для встраивания фронтенда с другого адреса (Dynamics 365), через запятую
CQA_CORS_ORIGINS=
# Название команды для results.json
CQA_TEAM_NAME=
# Вебхуки для Power Automate / Dynamics 365: адреса через запятую, секрет для подписи X-CQA-Signature (HMAC-SHA256)
CQA_WEBHOOK_URLS=
CQA_WEBHOOK_SECRET=
# Публичный адрес CQA для ссылок на карточку в событиях (например, https://cqa.company.kz)
CQA_PUBLIC_URL=
